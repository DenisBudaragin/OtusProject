<?xml version="1.0" encoding="UTF-8"?>
<browsers>
    <browser name="chrome" defaultVersion="{{ chrome_version }}">
        <version number="{{ chrome_version }}">
            <region name="selenoid-1">
                <host name="selenoid-1" port="4444" count="10"/>
            </region>
            <region name="selenoid-2">
                <host name="selenoid-2" port="4444" count="10"/>
            </region>
        </version>
    </browser>
    <browser name="firefox" defaultVersion="{{ firefox_version }}">
        <version number="{{ firefox_version }}">
            <region name="selenoid-1">
                <host name="selenoid-1" port="4444" count="5"/>
            </region>
            <region name="selenoid-2">
                <host name="selenoid-2" port="4444" count="5"/>
            </region>
        </version>
    </browser>
    <browser name="opera" defaultVersion="{{ opera_version }}">
        <version number="{{ opera_version }}">
            <region name="selenoid-1">
                <host name="selenoid-1" port="4444" count="5"/>
            </region>
            <region name="selenoid-2">
                <host name="selenoid-2" port="4444" count="5"/>
            </region>
        </version>
    </browser>
</browsers>