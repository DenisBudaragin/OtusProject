FROM {{ android_emulator_image }}:{{ android_emulator_tag }}

# Устанавливаем необходимые пакеты
USER root

# Обновляем пакеты и устанавливаем adb и bash
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    adb \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Установка Node.js и Appium
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest \
    && npm install -g appium@{{ appium_version }} \
    && npm install -g appium-doctor \
    && appium driver install uiautomator2 \
    && appium driver install espresso

# Создание директорий
RUN mkdir -p {{ android_apps_dir }} {{ android_results_dir }} {{ android_config_dir }} {{ android_logs_dir }}
RUN chmod -R 777 {{ android_base_dir }}

# Создаем симлинк для adb
RUN ln -sf /usr/bin/adb /usr/local/bin/adb

# Копирование entrypoint скрипта
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5555 5554 {{ appium_port }}

ENTRYPOINT ["/entrypoint.sh"]