services:
  android-emulator:
    image: {{ android_emulator_image }}:{{ android_emulator_tag }}
    container_name: android-emulator
    restart: unless-stopped
    privileged: true
    networks:
      - {{ docker_network_name }}
    ports:
      - "5555:5555"  # ADB
    environment:
      - ANDROID_DEVICE={{ android_device }}
      - REDROID_OPTS={{ redroid_opts }}
    # Добавляем command с параметрами ядра для отключения ADB авторизации
    command: >
      androidboot.hardware=redroid
      androidboot.redroid_gpu_mode=guest
      androidboot.redroid_memfd=true
      androidboot.redroid_width=1080
      androidboot.redroid_height=1920
      androidboot.redroid_dpi=480
      ro.adb.secure=0
      persist.adb.secure=0
      service.adb.tcp.port=5555
    volumes:
      - {{ android_apps_dir }}:/root/tmp
      - {{ android_results_dir }}:/root/test-results
      - /dev/kvm:/dev/kvm
    devices:
      - /dev/kvm
    mem_limit: {{ android_container_mem_limit | default('3g') }}
    cpus: "{{ android_container_cpu_limit | default('2') }}"

  appium-server:
    image: appium/appium:latest
    container_name: appium-server
    restart: unless-stopped
    networks:
      - selenoid_network
    ports:
      - "4723:4723"
    environment:
      - APPIUM_PORT=4723
    volumes:
      - /opt/android-emulator/apps:/root/tmp
      - /opt/android-emulator/test-results:/root/test-results
      - /var/run/docker.sock:/var/run/docker.sock
    # Упрощенная команда без sh -c
    command: appium --address 0.0.0.0 --port 4723 --allow-cors
    depends_on:
      - android-emulator

networks:
  {{ docker_network_name }}:
    external: true
    name: {{ docker_network_name }}